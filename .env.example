# Copy to .env and fill in. Never commit real keys.
# Stripe TEST MODE ONLY — v1 refuses any key that does not start with sk_test_.
STRIPE_TEST_SECRET_KEY=sk_test_...
STRIPE_TEST_PUBLISHABLE_KEY=pk_test_...
# Stripe webhook signing secret (production; local testing uses /api/fulfill)
STRIPE_WEBHOOK_SECRET=whsec_...

# Printful private API token: printful.com -> sign in -> Stores -> your store
# -> Settings -> API -> generate token. Fulfillment is dead without this.
PRINTFUL_API_TOKEN=

# Path to our-SKU -> Printful variant mapping (copy the .example file to start)
PRINTFUL_MAPPING=/home/hatch/workspace/pushrod-store/backend/fulfillment/printful_mapping.json

# Brand switch: pushrod (brand #1). restorationessentials later — config only.
BRAND=pushrod
PORT=8091

# Digital delivery (signed /download/<token> links, fulfillment/digital.py).
DIGITAL_DOWNLOAD_SECRET=   # HMAC secret for download-link tokens; set once and keep (rotating kills every outstanding link)
DIGITAL_FILES_DIR=         # local deliverables dir (default: data/digital)
# Delivery storage (fulfillment/storage.py). Default "local" serves from
# DIGITAL_FILES_DIR — the right shape while a catalog fits in git. For
# catalogs too large for git (RE guides: 383 PDFs / ~587 MB), set
# DIGITAL_STORAGE_BACKEND=s3 against a PRIVATE S3-compatible bucket
# (AWS S3 / Cloudflare R2 / Backblaze B2). The service streams bytes
# through the token check; buyers never receive a bucket URL.
DIGITAL_STORAGE_BACKEND=   # local (default) | s3
DIGITAL_S3_BUCKET=         # required for s3
DIGITAL_S3_REGION=         # default us-east-1; "auto" for Cloudflare R2
DIGITAL_S3_ENDPOINT=       # R2/B2/MinIO base URL (path-style); blank = AWS S3
DIGITAL_S3_ACCESS_KEY_ID=        # required for s3 — service env only, never git
DIGITAL_S3_SECRET_ACCESS_KEY=    # required for s3 — service env only, never git
DIGITAL_S3_PREFIX=         # optional object-key prefix (key = prefix + PDF basename)
